# 统一换行，避免 Windows 上 checkout 出 CRLF 导致 .sh 无法执行
* text=auto eol=lf

# 脚本强制 LF
*.sh        text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
*.json      text eol=lf

# 二进制（不做换行转换，避免损坏）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.mp3   binary
*.otf   binary
*.ttf   binary
*.woff2 binary
*.skel  binary
